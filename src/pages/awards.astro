---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { pagesById } from "../content/pages";
import { awards, awardStats, type Award } from "../content/portfolio";

const meta = pagesById.awards;

const topHonors = awards.filter((a) => a.category === "featured");
const provincial = awards.filter((a) => a.category === "provincial");
const other = awards.filter((a) => a.category === "other");

/**
 * Ledger sections below Top Honors — compact rows with a year column.
 */
const ledgers = [
  { key: "provincial", label: "Provincial", items: provincial },
  { key: "other", label: "Honors & Scholarships", items: other },
];

/** First 4-digit year, for the year column ("2021–2025" → "2021–25"). */
function shortYear(raw: string): string {
  const years = raw.match(/\d{4}/g);
  if (!years || years.length === 0) return raw;
  if (years.length === 1) return years[0];
  return `${years[0]}–${years[years.length - 1].slice(2)}`;
}
---

<Layout title="Awards — Akishai" description={meta.blurb}>
  <PageHeader pageId="awards" />

  <section class="mx-auto max-w-5xl px-6 pb-32">
    {/* ── Stats band — the whole page in four numbers ── */}
    <div
      class="grid grid-cols-2 overflow-hidden rounded-2xl border border-silver-600/20 bg-void-900/40 backdrop-blur-sm md:grid-cols-4"
      data-fade-in
    >
      {
        awardStats.map((s, i) => (
          <div
            class:list={[
              "stat-cell relative flex flex-col gap-1.5 p-6 md:p-7",
              // Hairline dividers: right edge except last column, top edge for
              // the second mobile row.
              i % 2 === 0 && "border-r border-silver-600/15",
              i >= 2 && "border-t border-silver-600/15 md:border-t-0",
              i < 3 && "md:border-r md:border-silver-600/15",
            ]}
          >
            <p class="text-gradient-gold font-display text-3xl leading-none md:text-4xl">
              {s.value}
            </p>
            <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-silver-300/85">
              {s.label}
            </p>
            <p class="text-xs leading-relaxed text-silver-500">{s.detail}</p>
          </div>
        ))
      }
    </div>

    {/* ── Top Honors — numbered ledger, one honor per row ── */}
    <div class="mt-20" data-fade-in>
      <header class="mb-2 flex items-baseline gap-4">
        <p class="font-mono text-[10px] uppercase tracking-[0.4em] text-gold-300/85">
          ◦ Top Honors
        </p>
        <span
          class="h-px flex-1 bg-gradient-to-r from-gold-500/25 via-gold-500/8 to-transparent"
        ></span>
        <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-silver-500">
          {String(topHonors.length).padStart(2, "0")}
        </span>
      </header>

      <ol class="honor-list" role="list">
        {
          topHonors.map((a, i) => (
            <li
              class="honor-row group relative grid grid-cols-[2.5rem_1fr] items-baseline gap-x-4 border-b border-silver-600/15 py-8 md:grid-cols-[3.5rem_1fr_auto] md:gap-x-8 md:py-10"
              style={`--row-delay: ${i * 70}ms`}
              data-reveal
            >
              {/* Ordinal + star node */}
              <span class="honor-ord relative" aria-hidden="true">
                <span class="honor-star" />
                <span class="font-mono text-xs tracking-[0.2em] text-gold-400/70">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </span>

              {/* Body */}
              <div class="min-w-0">
                <h3 class="font-display text-xl leading-snug text-silver-100 transition-colors group-hover:text-gold-100 md:text-2xl">
                  {a.name}
                </h3>
                <p class="mt-1.5 text-sm text-silver-400/85 md:text-[15px]">
                  <span class="font-mono text-gold-400/45">@</span>
                  <span class="ml-1 transition-colors group-hover:text-silver-300">
                    {a.org}
                  </span>
                  <span class="mx-2 text-silver-600">·</span>
                  <span class="font-mono text-xs tracking-[0.08em] text-silver-500">
                    {a.year}
                  </span>
                </p>
                {a.note && (
                  <p class="honor-note mt-3 max-w-2xl text-sm leading-relaxed text-silver-300/70">
                    {a.note}
                  </p>
                )}
                {/* Mobile-only value badge */}
                {a.value && (
                  <p class="mt-3 md:hidden">
                    <span class="rounded-full border border-gold-500/30 bg-gold-500/[0.06] px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-widest text-gold-300/95">
                      {a.value}
                    </span>
                  </p>
                )}
              </div>

              {/* Placement — big display type, desktop only */}
              {a.value && (
                <p class="honor-value hidden self-center text-right md:block">
                  <span class="text-gradient-gold font-display text-2xl italic leading-none lg:text-3xl">
                    {a.value}
                  </span>
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </div>

    {/* ── Provincial + Honors & Scholarships — compact ledgers ── */}
    <div class="mt-20 space-y-16">
      {
        ledgers.map(({ label, items }) => (
          <div data-fade-in>
            <header class="mb-2 flex items-baseline gap-4">
              <p class="font-mono text-[10px] uppercase tracking-[0.4em] text-gold-300/85">
                ◦ {label}
              </p>
              <span class="h-px flex-1 bg-gradient-to-r from-gold-500/25 via-gold-500/8 to-transparent" />
              <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-silver-500">
                {String(items.length).padStart(2, "0")}
              </span>
            </header>

            <ul class="ledger-list" role="list">
              {items.map((a, i) => (
                <li
                  class="ledger-row group relative grid grid-cols-[4.25rem_1fr] items-baseline gap-x-4 border-b border-silver-600/12 py-5 md:grid-cols-[4.25rem_1fr_auto] md:gap-x-6"
                  style={`--row-delay: ${i * 60}ms`}
                  data-reveal
                >
                  <span class="font-mono text-[11px] tracking-[0.08em] text-silver-500 transition-colors group-hover:text-gold-400/80">
                    {shortYear(a.year)}
                  </span>

                  <div class="min-w-0">
                    <h3 class="text-base leading-snug text-silver-100 transition-colors group-hover:text-gold-100 md:text-lg">
                      {a.name}
                    </h3>
                    <p class="mt-1 text-sm text-silver-400/80">
                      <span class="font-mono text-gold-400/45">@</span>
                      <span class="ml-1">{a.org}</span>
                      {a.note && (
                        <>
                          <span class="mx-2 text-silver-600">·</span>
                          <span class="text-silver-400/70">{a.note}</span>
                        </>
                      )}
                    </p>
                    {/* Mobile-only value badge */}
                    {a.value && (
                      <p class="mt-2 md:hidden">
                        <span class="rounded-full border border-gold-500/30 bg-gold-500/[0.06] px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-widest text-gold-300/95">
                          {a.value}
                        </span>
                      </p>
                    )}
                  </div>

                  {a.value && (
                    <span class="hidden shrink-0 self-center rounded-full border border-gold-500/30 bg-gold-500/[0.06] px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-widest text-gold-300/95 md:inline-block">
                      {a.value}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {/* Bottom flourish */}
    <div class="mt-20 text-center">
      <p class="font-mono text-[10px] uppercase tracking-[0.4em] text-silver-500">
        ◦ Onward ◦
      </p>
    </div>
  </section>
</Layout>

<style>
  /* ── Top Honors rows ── */

  /* Star node above the ordinal — a small four-point twinkle that ties the
     ledger back to the site's celestial language. Brightens on hover. */
  .honor-star {
    position: absolute;
    left: 2px;
    top: -14px;
    width: 7px;
    height: 7px;
    background: radial-gradient(circle at 35% 35%, #f4d896, #b8860b 70%);
    border-radius: 9999px;
    box-shadow: 0 0 8px rgba(212, 168, 90, 0.5);
    transition:
      box-shadow 320ms ease,
      transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .honor-star::before,
  .honor-star::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    background: rgba(244, 216, 150, 0.55);
    transition: opacity 320ms ease;
    opacity: 0.6;
  }
  .honor-star::before {
    width: 1px;
    height: 15px;
    transform: translate(-50%, -50%);
  }
  .honor-star::after {
    width: 15px;
    height: 1px;
    transform: translate(-50%, -50%);
  }
  .honor-row:hover .honor-star {
    box-shadow:
      0 0 14px rgba(232, 194, 117, 0.85),
      0 0 4px rgba(255, 230, 170, 0.6);
    transform: scale(1.15);
  }
  .honor-row:hover .honor-star::before,
  .honor-row:hover .honor-star::after {
    opacity: 1;
  }

  /* Gold wash easing in from the left on hover — row reads as a deliberate
     plaque without adding card chrome. */
  .honor-row::before,
  .ledger-row::before {
    content: "";
    position: absolute;
    inset: 0 -16px;
    background: linear-gradient(
      90deg,
      rgba(184, 134, 11, 0.06) 0%,
      rgba(184, 134, 11, 0.02) 45%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
    pointer-events: none;
  }
  .honor-row:hover::before,
  .ledger-row:hover::before {
    opacity: 1;
  }

  /* Bottom hairline warms up on hover */
  .honor-row,
  .ledger-row {
    transition: border-color 320ms ease;
  }
  .honor-row:hover,
  .ledger-row:hover {
    border-color: rgba(184, 134, 11, 0.28);
  }

  .honor-value span {
    display: inline-block;
    transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .honor-row:hover .honor-value span {
    transform: translateX(-2px) scale(1.02);
  }

  /* ── Entrances ── */
  [data-fade-in] {
    opacity: 0;
    transform: translateY(14px);
    animation: awardFade 700ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  @keyframes awardFade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .honor-row,
  .ledger-row {
    opacity: 0;
    transform: translateY(8px);
    animation: rowFade 600ms cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: calc(var(--row-delay, 0ms) + 150ms);
  }
  @keyframes rowFade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-fade-in],
    .honor-row,
    .ledger-row {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .honor-star,
    .honor-value span {
      transition: none;
    }
  }
</style>
